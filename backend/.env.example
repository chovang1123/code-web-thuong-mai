PORT=3000
PAYMENT_ENV=sandbox
VNP_TMN_CODE=
VNP_HASH_SECRET=
# Blank in development: http://localhost:<PORT>/api/vnpay/return
# Production requires an explicit HTTPS return URL.
VNPAY_RETURN_URL=
# Public HTTPS URL registered with VNPAY. A tunnel is needed for local IPN tests.
VNPAY_IPN_URL=
# Optional HTTP(S) callback bridge reachable from the phone. Android Emulator
# defaults to http://10.0.2.2:<PORT>/api/vnpay/return in development.
VNPAY_MOBILE_RETURN_URL=
# Frontend origin for VNPay browser returns
CLIENT_URL=http://localhost:5173

# Backend only. Replace placeholders with values from your Cloudinary account.
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME
# Optional: set only when you have a configured upload preset.
CLOUDINARY_UPLOAD_PRESET=
# Set true only when the named preset is configured for unsigned uploads.
CLOUDINARY_UPLOAD_UNSIGNED=false
