# Add these sandbox settings to backend/.env. PAYMENT_PUBLIC_URL is the backend origin.
# Register https://<backend>/api/payments/vnpay/ipn with VNPAY.
PAYMENT_PUBLIC_URL=
PAYMENT_ENV=sandbox
VNP_TMN_CODE=
VNP_HASH_SECRET=
# Frontend origin for VNPay browser returns
CLIENT_URL=http://localhost:5173
